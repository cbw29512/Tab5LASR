CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
CONFIG_CAMERA_SC202CS=y
CONFIG_CAM_CTRL_SPI_ENABLE=n
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# Never wipe a user's SD card when mounting fails.
# CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL is not set
CONFIG_LASR_SD_RECORDER=y
# Optimize the added FATFS/session code; do not shrink recovery or charger safeguards.
CONFIG_COMPILER_LTO_LINKTIME=y
CONFIG_COMPILER_LTO_COMPILETIME=y
CONFIG_FATFS_LFN_HEAP=y
